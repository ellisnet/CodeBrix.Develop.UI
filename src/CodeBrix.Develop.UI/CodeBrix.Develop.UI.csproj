<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodeBrix.Develop.UI</AssemblyName>
    <RootNamespace>CodeBrix.Develop.UI</RootNamespace>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>
  </PropertyGroup>

  <!--
    Package / assembly version: date-stamped and auto-incrementing.

    Format:  1.<x>.<y>.<z>   (every field is derived from UTC "now")

      1  (major)     Always 1 for this library.
      x  (minor)     Whole years since $(_VersionBaseYear).
                     With base 2026: 2026=0, 2027=1, 2028=2, ...
      y  (build)     Day of year, 1-based inclusive, UTC.
                     Jan 1 = 1, Feb 1 = 32, Dec 31 = 365 (366 in a leap year).
      z  (revision)  Minute of day, UTC, range 0 to 1439.
                     00:00 = 0, 23:59 = 1439.

    The version is always strictly increasing over time:
      * within a day, z grows;
      * at a day boundary, y increments and outranks z resetting to 0;
      * at a (UTC) year boundary, x increments and outranks y and z resetting.

    Notes / caveats:
      * All fields read from System.DateTime.UtcNow, so a local dev build and a
        UTC CI build agree on the value. Math.Floor on the minutes keeps z in
        0..1439 (plain rounding could land on 1440 late in the day).
      * Because the value depends on the clock, every build produces a NEW
        version. With GeneratePackageOnBuild=true that means a fresh .nupkg on
        each build, and two builds in the SAME UTC minute produce the SAME
        version (so do not publish two packages from within one minute).
      * This is date-stamp versioning, not SemVer: minor encodes the year and
        major is pinned to 1, so major/minor do not signal API compatibility.
      * To re-baseline the minor number, change _VersionBaseYear below.
  -->
  <PropertyGroup>
    <_VersionBaseYear>2026</_VersionBaseYear>
    <_VersionYears>$([MSBuild]::Subtract($([System.DateTime]::UtcNow.Year), $(_VersionBaseYear)))</_VersionYears>
    <_VersionDayOfYear>$([System.DateTime]::UtcNow.DayOfYear)</_VersionDayOfYear>
    <_VersionMinuteOfDay>$([System.Convert]::ToInt32($([System.Math]::Floor($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes)))))</_VersionMinuteOfDay>
    <BuildVersion>1.$(_VersionYears).$(_VersionDayOfYear).$(_VersionMinuteOfDay)</BuildVersion>
    <Version>$(BuildVersion)</Version>
    <AssemblyVersion>$(BuildVersion)</AssemblyVersion>
    <FileVersion>$(BuildVersion)</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CodeBrix.Develop.UI</PackageId>
    <Product>CodeBrix.Develop.UI</Product>
    <Title>CodeBrix.Develop.UI</Title>
    <Authors>Jeremy Ellis</Authors>
    <Description>A fully managed C# binding of the GTK 4 user-interface toolkit, the GtkSourceView source-code editing widget, and the supporting GNOME platform libraries for .NET 10.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ellisnet/CodeBrix.Develop.UI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ellisnet/CodeBrix.Develop.UI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon-codebrix-128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 Jeremy Ellis and contributors.</Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <PackageTags>gtk;gtk4;gtksourceview;gnome;gobject;gir;binding;desktop;ui;CodeBrix</PackageTags>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeReferencedProjectBuildOutputs</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <!--
    All 12 sibling library projects ship INSIDE this single package (there are
    no separate CodeBrix.Develop.UI.* packages). PrivateAssets="all" keeps the
    project references from being emitted as NuGet package dependencies, and
    the IncludeReferencedProjectBuildOutputs target below packs every
    referenced CodeBrix.Develop.UI.* DLL (and its XML doc file) into
    lib/net10.0/ alongside CodeBrix.Develop.UI.dll. The GtkSourceView binding
    is compiled directly into this assembly (the GtkSource/ folder).
  -->
  <ItemGroup>
    <ProjectReference Include="..\CodeBrix.Develop.UI.Gdk\CodeBrix.Develop.UI.Gdk.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\CodeBrix.Develop.UI.Gsk\CodeBrix.Develop.UI.Gsk.csproj" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="IncludeReferencedProjectBuildOutputs" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <_SiblingLibraryDll Include="@(ReferenceCopyLocalPaths)"
                          Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll' and $([System.String]::Copy('%(ReferenceCopyLocalPaths.Filename)').StartsWith('CodeBrix.Develop.UI'))" />
      <_SiblingLibraryDoc Include="@(_SiblingLibraryDll->'%(RootDir)%(Directory)%(Filename).xml')" />
      <BuildOutputInPackage Include="@(_SiblingLibraryDll)" />
      <BuildOutputInPackage Include="@(_SiblingLibraryDoc)" Condition="Exists('%(_SiblingLibraryDoc.Identity)')" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- The Gtk source generator / analyzer participates in this project's build and ships in the package (see below). -->
    <ProjectReference Include="..\Integrations\CodeBrix.Develop.UI.Gtk.Integration\CodeBrix.Develop.UI.Gtk.Integration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both Roslyn integration assemblies ship inside this single package as analyzers. -->
    <None Include="..\Integrations\CodeBrix.Develop.UI.Gtk.Integration\bin\$(Configuration)\net8.0\CodeBrix.Develop.UI.Gtk.Integration.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="..\Integrations\CodeBrix.Develop.UI.GObject.Integration\bin\$(Configuration)\net8.0\CodeBrix.Develop.UI.GObject.Integration.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\icon-codebrix-128.png" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\AGENT-README.txt" Pack="true" PackagePath="" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
